# 钉钉开放平台 → 企业内部应用 → 凭证与基础信息
DINGTALK_APP_KEY=dingxxxxxxxx
DINGTALK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
DINGTALK_AGENT_ID=123456789
DINGTALK_CORP_ID=dingxxxxxxxx

# 服务
PORT=3000
NODE_ENV=development

# JWT（生产环境请更换为随机长字符串）
JWT_SECRET=change-me-in-production-use-openssl-rand
JWT_EXPIRES_IN=7d

# 前端地址（CORS / 钉钉应用首页需与此一致）
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reimb
DB_PASSWORD=reimb123
DB_NAME=reimbursement

# 钉钉 OA 报销模板 processCode（方案 B，留空则开发环境自动降级方案 A）
DINGTALK_PROCESS_CODE=

# 审批模式覆盖：A=自研 H5 审批，B=钉钉 OA（默认读 sys_config）
# APPROVAL_MODE=A

# Stream 订阅 OA 事件（本地无公网可保持 true，需配置 appKey/Secret）
DINGTALK_STREAM_ENABLED=true

# HTTP 回调（备选，需公网 HTTPS；与 Stream 二选一或并存）
# DINGTALK_CALLBACK_TOKEN=your_token
# DINGTALK_CALLBACK_AES_KEY=43chars_encoding_aes_key_from_dingtalk_console
# OA 附件控件 label，须与模板一致（默认「发票及凭证」，若模板用「附件」则改此值）
# DINGTALK_OA_ATTACHMENT_LABEL=附件

# 手动模拟 OA webhook 密钥（可选）
# WEBHOOK_SECRET=dev-secret

# 附件上传目录（相对 backend 根目录）
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10
