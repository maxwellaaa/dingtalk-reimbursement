# ============================================================
# 生产环境配置示例 · 复制为 .env 后填写真实值
# 切勿将含密钥的 .env 提交到 Git
# ============================================================

# --- MySQL（Docker Compose 生产栈）---
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
DB_HOST=mysql
DB_PORT=3306
DB_USER=reimb
DB_PASSWORD=change-me-strong-db-password
DB_NAME=reimbursement

# --- 钉钉开放平台（必填）---
DINGTALK_APP_KEY=dingxxxxxxxx
DINGTALK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
DINGTALK_AGENT_ID=123456789
DINGTALK_CORP_ID=dingxxxxxxxx

# OA 报销模板 processCode（方案 B）
DINGTALK_PROCESS_CODE=PROC-XXXX-XXXX

# Stream 订阅 OA 事件（推荐 true；需 appKey/Secret 有效）
DINGTALK_STREAM_ENABLED=true

# HTTP 回调（备选，需公网 HTTPS；与 Stream 可并存）
# DINGTALK_CALLBACK_TOKEN=
# DINGTALK_CALLBACK_AES_KEY=

# OA 附件控件 label（须与钉钉模板一致）
# DINGTALK_OA_ATTACHMENT_LABEL=发票及凭证

# --- 应用 ---
NODE_ENV=production
PORT=3000

# 生产前端公网地址（CORS + 钉钉 H5 首页须一致，含 /h5/）
FRONTEND_URL=https://reimb.example.com/h5

# JWT（务必更换：openssl rand -base64 48）
JWT_SECRET=replace-with-openssl-rand-base64-48-chars-minimum
JWT_EXPIRES_IN=7d

# 审批模式：B=钉钉 OA（生产默认）；A=自研 H5 审批
# APPROVAL_MODE=B

# 附件
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10

# Docker 对外 HTTP 端口（frontend nginx）
HTTP_PORT=8080

# 备份脚本可选（scripts/backup/*）
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14
# Windows 若 mysqldump 不在 PATH，可指定：
# MYSQLDUMP_BIN=C:\Program Files\MySQL\MySQL Server 9.7\bin\mysqldump.exe
# MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 9.7\bin\mysql.exe
